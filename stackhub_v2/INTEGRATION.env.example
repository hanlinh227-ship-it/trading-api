# Copy these names into your deployment/system secret store.
# Never commit real values.

# External job lane
TASKBOUNTY_API_KEY=

# Optional zero-spend solver bridge. Value is a command, configured by your runtime wrapper.
# Do not put marketplace credentials into the solver environment.
STACKHUB_SOLVER_COMMAND=

# PayPal credentials are intentionally NOT requested by STACKHUB.
# Link PayPal inside each platform's own payout settings.
