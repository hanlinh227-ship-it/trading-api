# STACKHUB V2 account integration secret names.
# Copy only the variable NAMES into your deployment/system secret store.
# Never commit real values and never paste them into chat/logs/issues.

# External job lane — AUTO when source capability verification is green.
TASKBOUNTY_API_KEY=

# Digital product lane — observation/management API only.
# Gumroad currently does not support creating/uploading products through its API,
# so publishing new products remains ASSISTED.
GUMROAD_ACCESS_TOKEN=

# Optional zero-spend solver bridge. Value is a command configured by your runtime wrapper.
# Marketplace/account secrets are stripped from the solver subprocess environment.
STACKHUB_SOLVER_COMMAND=

# Intentionally NOT requested by STACKHUB:
# - PayPal password/session/API credentials for receiving marketplace payouts
# - bank password/card/CVV
# - wallet seed phrase/private key
# - Adobe account password
# - RapidAPI account password
# - GitHub password/2FA recovery codes
# Link payout rails and complete OAuth/KYC/tax steps inside each official platform.
