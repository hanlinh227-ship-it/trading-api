{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "signalhub-forex",
  "main": "gateway-v3.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "kv_namespaces": [
    {
      "binding": "SIGNALS_KV",
      "id": "96ca4ccc87a4462c8797c7f5e20cea4b"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "MT5_LIVE", "class_name": "MT5LiveState" }
    ]
  },
  "migrations": [
    { "tag": "v34-mt5-live-v1", "new_sqlite_classes": ["MT5LiveState"] }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
