{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project.schema.json",
  "type": "object",
  "required": ["version", "projects"],
  "properties": {
    "version": {"const": 1},
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "authority", "canonical_checkpoint", "routed_by"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "status": {"enum": ["CURRENT", "ACTIVE", "CURRENT_AUTHORITY", "HISTORICAL", "RETIRED"]},
          "authority": {"type": "string", "minLength": 1},
          "canonical_checkpoint": {"type": "string", "minLength": 1},
          "routed_by": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
