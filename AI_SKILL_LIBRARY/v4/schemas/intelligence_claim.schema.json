{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Peer Intelligence Claim",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "claim_id", "learning_layer", "source_id", "source_revision", "authority_type",
    "observed_at", "domain", "statement_hash", "reproducibility", "benchmark_refs",
    "confidence", "contradiction_ids", "verification_state", "source_integrity"
  ],
  "properties": {
    "claim_id": {"type": "string", "minLength": 1},
    "learning_layer": {"enum": ["experience", "curated", "exploration"]},
    "source_id": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "minLength": 1},
    "authority_type": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "minLength": 1},
    "freshness_deadline": {"type": ["string", "null"]},
    "domain": {"type": "string", "minLength": 1},
    "statement": {"type": "string", "minLength": 1},
    "statement_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "conflict_key": {"type": ["string", "null"]},
    "reproducibility": {"enum": ["unknown", "not_reproduced", "reproduced"]},
    "benchmark_refs": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "contradiction_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "verification_state": {"enum": ["unverified", "verified", "rejected"]},
    "source_integrity": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
