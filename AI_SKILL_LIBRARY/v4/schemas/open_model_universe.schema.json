{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "open_model_universe.schema.json",
  "title": "Open Model Universe authority-free metadata registry",
  "type": "object",
  "required": ["version", "registry_id", "policy", "authority", "models"],
  "properties": {
    "version": {"const": 1},
    "registry_id": {"const": "OPEN_MODEL_UNIVERSE"},
    "policy": {
      "type": "object",
      "required": ["cost_policy", "paid_fallback", "registry_implies_activation", "auto_download"],
      "properties": {
        "cost_policy": {"const": "OPEN_MODEL_ZERO_TOKEN_FIRST"},
        "paid_fallback": {"const": "NO_PAID_FALLBACK"},
        "registry_implies_activation": {"const": false},
        "auto_download": {"const": false}
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": ["routing", "reasoning", "permission", "memory", "project_truth", "final_answer"],
      "properties": {
        "routing": {"const": false},
        "reasoning": {"const": false},
        "permission": {"const": false},
        "memory": {"const": false},
        "project_truth": {"const": false},
        "final_answer": {"const": false}
      },
      "additionalProperties": false
    },
    "models": {"type": "array", "items": {"$ref": "#/$defs/model"}}
  },
  "additionalProperties": false,
  "$defs": {
    "truth": {"enum": [true, false, "unknown"]},
    "security": {
      "type": "object",
      "required": [
        "revision_pinned", "digest_verified", "safe_format", "pickle_risk",
        "trust_remote_code_required", "custom_code_required", "license_verified",
        "provenance_verified", "malware_scan_status", "isolated_load_required",
        "egress_required", "rollback_artifact_available"
      ],
      "properties": {
        "revision_pinned": {"type": "boolean"},
        "digest_verified": {"type": "boolean"},
        "safe_format": {"type": "boolean"},
        "pickle_risk": {"type": "boolean"},
        "trust_remote_code_required": {"type": "boolean"},
        "custom_code_required": {"type": "boolean"},
        "license_verified": {"type": "boolean"},
        "provenance_verified": {"type": "boolean"},
        "malware_scan_status": {"enum": ["not_scanned", "pass", "fail", "unknown"]},
        "isolated_load_required": {"type": "boolean"},
        "egress_required": {"type": "boolean"},
        "rollback_artifact_available": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "lineage": {
      "type": "object",
      "properties": {
        "lineage_id": {"type": ["string", "null"]},
        "family": {"type": ["string", "null"]},
        "base_model": {"type": ["string", "null"]},
        "fine_tune_parent": {"type": ["string", "null"]},
        "distillation_parent": {"type": ["string", "null"]},
        "quantization_parent": {"type": ["string", "null"]},
        "lora_parent": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "runtime_projection": {
      "type": "object",
      "required": [
        "model_id", "family", "revision", "artifact_hash", "artifact_size_bytes",
        "quantization", "runtime_support", "minimum_ram_gb", "recommended_ram_gb",
        "minimum_vram_gb", "recommended_vram_gb", "cpu_viable", "privacy_class",
        "zero_cost_eligible", "admission_status"
      ],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "family": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 7},
        "artifact_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "artifact_size_bytes": {"type": "integer", "minimum": 1},
        "quantization": {"type": "string", "minLength": 1},
        "runtime_support": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "minimum_ram_gb": {"type": ["number", "null"], "minimum": 0},
        "recommended_ram_gb": {"type": ["number", "null"], "minimum": 0},
        "minimum_vram_gb": {"type": ["number", "null"], "minimum": 0},
        "recommended_vram_gb": {"type": ["number", "null"], "minimum": 0},
        "cpu_viable": {"$ref": "#/$defs/truth"},
        "privacy_class": {"type": "string", "minLength": 1},
        "zero_cost_eligible": {"type": "boolean"},
        "admission_status": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": [
        "model_id", "family", "variant", "base_model", "quantization", "runtime_build",
        "official_upstream", "weights_source", "upstream_revision", "release_date",
        "license_name", "license_url", "license_class", "license_verified",
        "commercial_use", "self_hostable", "redistribution", "derivative_training",
        "open_weight", "api_required", "paid_token_required", "local_runtime_possible",
        "capabilities", "hardware_profile", "runtime_support", "context_window",
        "benchmark_profile", "quality_class", "latency_class", "privacy_class",
        "cost_class", "lifecycle_state", "health", "last_verified", "authority",
        "source_evidence"
      ],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "family": {"type": "string", "minLength": 1},
        "variant": {"type": "string", "minLength": 1},
        "base_model": {"type": "string", "minLength": 1},
        "quantization": {"type": "string", "minLength": 1},
        "runtime_build": {"type": "string", "minLength": 1},
        "official_upstream": {"type": "string", "pattern": "^https://", "format": "uri"},
        "weights_source": {"type": "string", "pattern": "^https://", "format": "uri"},
        "upstream_revision": {"type": "string", "minLength": 1},
        "immutable_revision": {"type": "string", "minLength": 7},
        "artifact_url": {"type": "string", "pattern": "^https://", "format": "uri"},
        "artifact_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "artifact_size_bytes": {"type": "integer", "minimum": 1},
        "artifact_format": {"type": "string", "minLength": 1},
        "release_date": {"type": ["string", "null"], "format": "date"},
        "license_name": {"type": "string", "minLength": 1},
        "license_url": {"type": "string", "pattern": "^https://", "format": "uri"},
        "license_class": {"enum": ["permissive", "open_weight_custom", "research_only", "restricted", "unclear"]},
        "license_verified": {"type": "boolean"},
        "commercial_use": {"$ref": "#/$defs/truth"},
        "self_hostable": {"type": "boolean"},
        "redistribution": {"enum": ["allowed", "restricted", "unknown"]},
        "derivative_training": {"enum": ["allowed", "restricted", "unknown"]},
        "open_weight": {"type": "boolean"},
        "api_required": {"type": "boolean"},
        "paid_token_required": {"type": "boolean"},
        "local_runtime_possible": {"type": "boolean"},
        "zero_cost_eligible": {"type": "boolean"},
        "offline_ready": {"type": "boolean"},
        "capabilities": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}},
        "hardware_profile": {
          "type": "object",
          "required": ["minimum_ram_gb", "recommended_ram_gb", "minimum_vram_gb", "recommended_vram_gb", "quantization_options", "cpu_viable", "apple_silicon_viable"],
          "properties": {
            "minimum_ram_gb": {"type": ["number", "null"], "minimum": 0},
            "recommended_ram_gb": {"type": ["number", "null"], "minimum": 0},
            "minimum_vram_gb": {"type": ["number", "null"], "minimum": 0},
            "recommended_vram_gb": {"type": ["number", "null"], "minimum": 0},
            "quantization_options": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "cpu_viable": {"$ref": "#/$defs/truth"},
            "apple_silicon_viable": {"$ref": "#/$defs/truth"},
            "gpu_viable": {"$ref": "#/$defs/truth"}
          },
          "additionalProperties": false
        },
        "runtime_support": {
          "type": "array",
          "items": {"enum": ["llama_cpp", "vllm", "sglang", "ollama", "transformers", "mlx", "tgi", "lmdeploy", "other"]},
          "uniqueItems": true
        },
        "context_window": {"type": ["integer", "null"], "minimum": 1},
        "benchmark_profile": {"type": "string", "minLength": 1},
        "quality_class": {"type": "string", "minLength": 1},
        "latency_class": {"type": "string", "minLength": 1},
        "privacy_class": {"type": "string", "minLength": 1},
        "cost_class": {"enum": ["zero_paid_token_candidate", "owned_hardware_zero_marginal", "verified_recurring_free", "verified_free_quota_hard_stop", "unknown"]},
        "lifecycle_state": {"enum": ["DISCOVERED", "QUARANTINED", "REGISTERED", "APPROVED", "AVAILABLE", "DOWNLOADING", "CACHED", "WARM", "RUNNING", "SLEEPING", "DEGRADED", "BROKEN", "EVICTED", "SUPERSEDED", "RETIRED", "BLOCKED", "QUARANTINED_UPDATE"]},
        "health": {"enum": ["unknown", "healthy", "degraded", "broken", "blocked"]},
        "last_verified": {"type": ["string", "null"], "format": "date-time"},
        "lineage": {"$ref": "#/$defs/lineage"},
        "admission_status": {"type": "string", "minLength": 1},
        "artifact_security": {"$ref": "#/$defs/security"},
        "runtime_projection": {"$ref": "#/$defs/runtime_projection"},
        "authority": {"const": false},
        "source_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^https://", "format": "uri"}, "uniqueItems": true}
      },
      "additionalProperties": false
    }
  }
}
