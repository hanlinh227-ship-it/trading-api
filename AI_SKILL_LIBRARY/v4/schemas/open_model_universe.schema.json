{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "open_model_universe.schema.json",
  "title": "Open Model Universe authority-free governance and admission registry",
  "type": "object",
  "required": ["version", "registry_id", "policy", "authority", "integration", "models"],
  "properties": {
    "version": {"const": 1},
    "registry_id": {"const": "OPEN_MODEL_UNIVERSE"},
    "policy": {
      "type": "object",
      "required": ["cost_policy", "paid_fallback", "registry_implies_activation", "auto_download"],
      "properties": {
        "cost_policy": {"const": "OPEN_MODEL_ZERO_TOKEN_FIRST"},
        "paid_fallback": {"const": "NO_PAID_FALLBACK"},
        "registry_implies_activation": {"const": false},
        "auto_download": {"const": false}
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": ["routing", "reasoning", "permission", "memory", "project_truth", "final_answer"],
      "properties": {
        "routing": {"const": false},
        "reasoning": {"const": false},
        "permission": {"const": false},
        "memory": {"const": false},
        "project_truth": {"const": false},
        "final_answer": {"const": false}
      },
      "additionalProperties": false
    },
    "integration": {
      "type": "object",
      "required": ["brain_authority", "routed_by", "model_selection_authority", "activation_source", "registry_membership_is_activation", "ingress_hardcodes_model", "runtime_residency_contract"],
      "properties": {
        "brain_authority": {"const": "GITHUB_BRAIN_V4"},
        "routed_by": {"const": "task_router"},
        "model_selection_authority": {"const": "model_mesh"},
        "activation_source": {"const": "AI_SKILL_LIBRARY/v4/model_mesh/active.json"},
        "registry_membership_is_activation": {"const": false},
        "ingress_hardcodes_model": {"const": false},
        "runtime_residency_contract": {
          "type": "object",
          "required": ["owner", "governance_state_source", "open_model_universe_has_runtime_residency_authority"],
          "properties": {
            "owner": {"const": "claude_local_runtime"},
            "governance_state_source": {"const": "Open Model Universe"},
            "open_model_universe_has_runtime_residency_authority": {"const": false}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "models": {"type": "array", "items": {"$ref": "#/$defs/model"}}
  },
  "additionalProperties": false,
  "$defs": {
    "truth": {"enum": [true, false, "unknown"]},
    "artifact_identity": {
      "type": "object",
      "required": ["model_id", "family", "variant", "immutable_revision", "sha256", "size_bytes", "format", "quantization"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "family": {"type": "string", "minLength": 1},
        "variant": {"type": "string", "minLength": 1},
        "immutable_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "format": {"enum": ["gguf", "safetensors", "mlx", "other"]},
        "quantization": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "admission_evidence": {
      "type": "object",
      "required": ["license_verified", "provenance_verified", "safe_format_verified", "pickle_safe", "trust_remote_code_required", "custom_code_required", "malware_scan_status", "isolated_first_load_required", "first_load_egress_allowed", "quarantine_status"],
      "properties": {
        "license_verified": {"type": "boolean"},
        "provenance_verified": {"type": "boolean"},
        "safe_format_verified": {"type": "boolean"},
        "pickle_safe": {"enum": [true, false, "unknown"]},
        "trust_remote_code_required": {"enum": [true, false, "unknown"]},
        "custom_code_required": {"enum": [true, false, "unknown"]},
        "malware_scan_status": {"enum": ["pass", "fail", "not_run", "unknown"]},
        "isolated_first_load_required": {"type": "boolean"},
        "first_load_egress_allowed": {"type": "boolean"},
        "quarantine_status": {"enum": ["clear", "quarantined", "blocked", "unknown"]}
      },
      "additionalProperties": false
    },
    "operator_risk_acceptance": {
      "description": "A named, digest-bound operator decision to accept a check that cannot be run in the deploying environment. It is never a substituted finding: the underlying evidence field keeps its true value and this record sits beside it. It may cover malware_scan_status only.",
      "type": "object",
      "required": [
        "accepted_by", "accepted_at", "artifact_sha256", "basis",
        "missing_evidence", "covers", "scope", "is_a_scan_result"
      ],
      "properties": {
        "accepted_by": {"type": "string", "minLength": 1},
        "accepted_at": {"type": "string", "format": "date-time"},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "basis": {"type": "string", "minLength": 1},
        "missing_evidence": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "covers": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["malware_scan_status"]}
        },
        "scope": {"const": "single_artifact"},
        "is_a_scan_result": {"const": false},
        "note": {"type": "string"}
      },
      "additionalProperties": false
    },
    "lineage": {
      "type": "object",
      "required": ["source_model_id", "source_revision", "conversion_owner", "conversion_verified"],
      "properties": {
        "source_model_id": {"type": "string", "minLength": 1},
        "source_revision": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "conversion_owner": {"type": "string", "minLength": 1},
        "conversion_verified": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": [
        "model_id", "family", "variant", "base_model", "quantization", "runtime_build",
        "official_upstream", "weights_source", "upstream_revision", "release_date",
        "license_name", "license_url", "license_class", "license_verified",
        "commercial_use", "self_hostable", "redistribution", "derivative_training",
        "open_weight", "api_required", "paid_token_required", "local_runtime_possible",
        "capabilities", "hardware_profile", "runtime_support", "offline_eligible", "lineage",
        "context_window", "benchmark_profile", "quality_class", "latency_class", "privacy_class",
        "cost_class", "lifecycle_state", "health", "last_verified", "authority", "source_evidence",
        "artifact_identity", "admission_evidence", "model_mesh_local_candidate_eligible"
      ],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "family": {"type": "string", "minLength": 1},
        "variant": {"type": "string", "minLength": 1},
        "base_model": {"type": "string", "minLength": 1},
        "quantization": {"type": "string", "minLength": 1},
        "runtime_build": {"type": "string", "minLength": 1},
        "official_upstream": {"type": "string", "pattern": "^https://", "format": "uri"},
        "weights_source": {"type": "string", "pattern": "^https://", "format": "uri"},
        "upstream_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "release_date": {"type": ["string", "null"], "format": "date"},
        "license_name": {"type": "string", "minLength": 1},
        "license_url": {"type": "string", "pattern": "^https://", "format": "uri"},
        "license_class": {"enum": ["permissive", "open_weight_custom", "research_only", "restricted", "unclear"]},
        "license_verified": {"type": "boolean"},
        "commercial_use": {"$ref": "#/$defs/truth"},
        "self_hostable": {"type": "boolean"},
        "redistribution": {"enum": ["allowed", "restricted", "unknown"]},
        "derivative_training": {"enum": ["allowed", "restricted", "unknown"]},
        "open_weight": {"type": "boolean"},
        "api_required": {"type": "boolean"},
        "paid_token_required": {"type": "boolean"},
        "local_runtime_possible": {"type": "boolean"},
        "capabilities": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}},
        "hardware_profile": {
          "type": "object",
          "required": ["minimum_ram_gb", "recommended_ram_gb", "minimum_vram_gb", "recommended_vram_gb", "quantization_options", "cpu_viable", "apple_silicon_viable"],
          "properties": {
            "minimum_ram_gb": {"type": ["number", "null"], "minimum": 0},
            "recommended_ram_gb": {"type": ["number", "null"], "minimum": 0},
            "minimum_vram_gb": {"type": ["number", "null"], "minimum": 0},
            "recommended_vram_gb": {"type": ["number", "null"], "minimum": 0},
            "quantization_options": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "cpu_viable": {"$ref": "#/$defs/truth"},
            "apple_silicon_viable": {"$ref": "#/$defs/truth"}
          },
          "additionalProperties": false
        },
        "runtime_support": {"type": "array", "items": {"enum": ["llama_cpp", "vllm", "sglang", "ollama", "transformers", "mlx", "tgi", "lmdeploy", "other"]}, "uniqueItems": true},
        "offline_eligible": {"$ref": "#/$defs/truth"},
        "lineage": {"$ref": "#/$defs/lineage"},
        "context_window": {"type": ["integer", "null"], "minimum": 1},
        "benchmark_profile": {"type": "string", "minLength": 1},
        "quality_class": {"type": "string", "minLength": 1},
        "latency_class": {"type": "string", "minLength": 1},
        "privacy_class": {"type": "string", "minLength": 1},
        "cost_class": {"enum": ["zero_paid_token_candidate", "owned_hardware_zero_marginal", "verified_recurring_free", "verified_free_quota_hard_stop", "unknown"]},
        "lifecycle_state": {"enum": ["DISCOVERED", "QUARANTINED", "QUARANTINED_UPDATE", "REGISTERED", "APPROVED", "AVAILABLE", "BLOCKED", "SUPERSEDED", "RETIRED"]},
        "health": {"enum": ["unknown", "healthy", "degraded", "broken", "blocked"]},
        "last_verified": {"type": ["string", "null"], "format": "date-time"},
        "authority": {"const": false},
        "source_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^https://", "format": "uri"}, "uniqueItems": true},
        "artifact_identity": {"$ref": "#/$defs/artifact_identity"},
        "admission_evidence": {"$ref": "#/$defs/admission_evidence"},
        "model_mesh_local_candidate_eligible": {"type": "boolean"},
        "operator_risk_acceptance": {"$ref": "#/$defs/operator_risk_acceptance"},
        "malware_scan_reference": {"$ref": "#/$defs/malware_scan_reference"},
        "capability_evidence": {"type": "object", "description": "Per-capability measurement evidence. A declared capability score above zero must be backed by a matching entry here - the registry may not assert a capability nobody measured.", "additionalProperties": {"$ref": "#/$defs/capability_measurement"}}
      },
      "additionalProperties": false
    },
    "malware_scan_reference": {
      "type": "object",
      "description": "Provenance for a signature-based malware scan performed outside this runtime. Bound to the digest it scanned, so a result can never be applied to different bytes. It records where a finding came from; it never replaces admission_evidence.malware_scan_status.",
      "required": ["engine", "signature_database_version", "scanned_at", "scanned_by", "artifact_sha256"],
      "properties": {
        "engine": {"type": "string", "minLength": 1},
        "signature_database_version": {"type": "string", "minLength": 1},
        "scanned_at": {"type": "string", "minLength": 1},
        "scanned_by": {"type": "string", "minLength": 1},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "capability_measurement": {
      "type": "object",
      "description": "One capability score and the run that produced it. Bound to the exact artifact digest and the exact frozen suite, so a score cannot be carried onto different bytes or a reworded suite.",
      "required": ["score", "benchmark_id", "benchmark_version", "suite_hash", "is_public_benchmark", "attempted", "passed", "errors", "measured_at", "artifact_sha256", "runtime", "evidence_ref"],
      "properties": {
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "benchmark_id": {"type": "string", "minLength": 1},
        "benchmark_version": {"type": "string", "minLength": 1},
        "suite_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "is_public_benchmark": {"type": "boolean"},
        "attempted": {"type": "integer", "minimum": 1},
        "passed": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0},
        "measured_at": {"type": "string", "minLength": 1},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "runtime": {"type": "string", "minLength": 1},
        "evidence_ref": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
