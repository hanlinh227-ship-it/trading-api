{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "version", "domain", "triggers", "excludes", "requires", "conflicts_with", "bridges", "tools", "sources", "permissions", "risk_class", "output_contract", "evals", "provenance", "license", "compatibility"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_\\-]+$"},
    "version": {"type": "string"},
    "domain": {"type": "string"},
    "triggers": {"type": "array", "items": {"type": "string"}},
    "excludes": {"type": "array", "items": {"type": "string"}},
    "requires": {"type": "array", "items": {"type": "string"}},
    "conflicts_with": {"type": "array", "items": {"type": "string"}},
    "bridges": {"type": "array", "items": {"type": "string"}},
    "tools": {"type": "array", "items": {"type": "string"}},
    "sources": {"type": "array", "items": {"type": "string"}},
    "permissions": {"type": "array", "items": {"type": "string"}},
    "risk_class": {"enum": ["read_only", "reversible_write", "destructive", "financial", "credential_sensitive"]},
    "output_contract": {"type": "string", "minLength": 1},
    "evals": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "provenance": {"type": "object"},
    "license": {"type": "string"},
    "compatibility": {"type": "object"}
  },
  "additionalProperties": true
}
