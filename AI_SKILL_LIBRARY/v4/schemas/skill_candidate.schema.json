{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brain Native Skill Candidate",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "candidate_id", "skill_id", "lineage_id", "parent_version", "domain",
    "source_claims", "learning_layers", "risk_class", "permission_ceiling",
    "eval_plan", "status", "created_at", "stable_write_allowed"
  ],
  "properties": {
    "candidate_id": {"type": "string", "minLength": 1},
    "skill_id": {"type": "string", "minLength": 1},
    "lineage_id": {"type": "string", "minLength": 1},
    "parent_version": {"type": ["string", "null"]},
    "domain": {"type": "string", "minLength": 1},
    "source_claims": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "learning_layers": {"type": "array", "minItems": 1, "items": {"enum": ["experience", "curated", "exploration"]}, "uniqueItems": true},
    "risk_class": {"enum": ["A", "B", "C", "D"]},
    "permission_ceiling": {"enum": ["read_only", "bounded_write", "sandbox_execute"]},
    "eval_plan": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "status": {"enum": ["incubating", "eval_ready", "benchmarked", "canary", "champion_candidate", "promoted", "superseded", "retired"]},
    "created_at": {"type": "string", "minLength": 1},
    "stable_write_allowed": {"type": "boolean"},
    "content_digest": {"type": "string"}
  }
}
