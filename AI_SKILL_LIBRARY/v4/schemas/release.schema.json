{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "architecture", "files", "compatibility", "promotion"],
  "properties": {
    "version": {"type": "string", "pattern": "^4\\.0\\.[0-9]+$"},
    "architecture": {"const": "GITHUB_BRAIN_V4"},
    "files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["path", "sha256", "role"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "role": {"type": "string", "minLength": 1}
        }, "additionalProperties": false
      }
    },
    "compatibility": {"type": "object", "required": ["min_architecture"], "properties": {"min_architecture": {"const": "4.0.0"}}, "additionalProperties": false},
    "promotion": {"type": "object", "required": ["class", "validated"], "properties": {"class": {"type": "string"}, "validated": {"type": "boolean"}}, "additionalProperties": true}
  },
  "additionalProperties": true
}
