[Unit]
Description=Continuous Crypto 50-Day Research Loop
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/trading-api
Environment=NODE_ENV=production
Environment=CRYPTO_RESEARCH_STATE_DIR=/var/lib/trading-api/crypto-50d
ExecStart=/usr/bin/env node research/continuous-crypto-50d-runner.js
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
StandardOutput=append:/var/log/trading-api/crypto-50d.log
StandardError=append:/var/log/trading-api/crypto-50d-error.log

# Hardening without blocking outbound market-data access
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/trading-api /var/log/trading-api

[Install]
WantedBy=multi-user.target
