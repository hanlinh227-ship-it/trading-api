[Unit]
Description=MT5 Forex Local Bridge Sidecar
After=network-online.target mt5-forex.service
Wants=network-online.target
Requires=mt5-forex.service
PartOf=mt5-forex.service
ConditionPathExists=/etc/trading/mt5-forex-vps-only
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=mt5forex
Group=mt5forex
EnvironmentFile=/var/lib/trading/mt5-forex/runtime.env
EnvironmentFile=/etc/trading/mt5-forex.env
ExecStart=/usr/bin/python3 /opt/trading/trading-api-main/vps/mt5-forex/forex-mt5-sidecar.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/trading/mt5-forex
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
