[Unit]
Description=MT5 Forex Auto Trading Terminal (VPS Only)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/trading/mt5-forex-vps-only
ConditionPathExists=/var/lib/trading/mt5-forex/runtime.env
StartLimitIntervalSec=900
StartLimitBurst=6

[Service]
Type=simple
User=mt5forex
Group=mt5forex
Environment=HOME=/var/lib/trading/mt5-forex
Environment=MT5_EXPECTED_HOST=59670.vpsvinahost.vn
# The deployment writes /etc/trading as root-only while creating secrets. Before
# dropping into the mt5forex runtime, grant directory traversal only to the MT5
# group; individual secret files remain 0640 root:mt5forex and are never public.
ExecStartPre=+/usr/bin/chown root:mt5forex /etc/trading
ExecStartPre=+/usr/bin/chmod 0750 /etc/trading
ExecStartPre=/usr/bin/test -r /etc/trading/mt5-forex-vps-only
ExecStartPre=/usr/bin/test -r /var/lib/trading/mt5-forex/runtime.env
ExecStartPre=/usr/bin/test -r /etc/trading/mt5-forex.env
ExecStart=/opt/trading/trading-api-main/vps/mt5-forex/run-mt5-forex.sh
Restart=on-failure
RestartSec=15
# Exponential backoff (systemd >= 254; older systemd safely ignores these):
# 15s -> ... -> 300s over 6 steps instead of a fixed fast loop.
RestartSteps=6
RestartMaxDelaySec=300
# Configuration/environment failures cannot be fixed by restarting:
#  9=vps marker, 10=runtime.env, 11=LIVE credentials, 12=bridge token,
#  15=winepath, 91=unauthorized host. Terminal failures (69 appear, 70 exit)
#  are NOT listed and keep restarting with backoff.
RestartPreventExitStatus=9 10 11 12 15 91
TimeoutStartSec=120
TimeoutStopSec=20
KillMode=mixed
SendSIGKILL=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/trading/mt5-forex /opt/trading/mt5-forex-terminal

[Install]
WantedBy=multi-user.target
