[Unit]
Description=Crypto 50D safe telemetry snapshot
After=crypto-50d.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/trading/trading-api-main/scripts
EnvironmentFile=/etc/trading/crypto-50d.env
ExecStart=/usr/bin/python3 /opt/trading/trading-api-main/scripts/crypto_50d_status.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/trading/crypto-50d
