[Unit]
Description=Crypto 50-Day V3 Rigorous 3AI PAPER_ONLY Research
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/trading/trading-api-main/scripts
EnvironmentFile=/etc/trading/crypto-50d.env
EnvironmentFile=-/etc/trading/ai-providers.env
ExecStartPre=/usr/bin/python3 -m py_compile /opt/trading/trading-api-main/scripts/continuous_crypto_50d.py /opt/trading/trading-api-main/scripts/crypto_3ai_learner.py /opt/trading/trading-api-main/scripts/continuous_crypto_50d_v3.py
ExecStart=/usr/bin/python3 /opt/trading/trading-api-main/scripts/continuous_crypto_50d_v3.py
Restart=always
RestartSec=10
KillMode=control-group
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/trading/crypto-50d /var/lib/trading/crypto-50d-v3

[Install]
WantedBy=multi-user.target
