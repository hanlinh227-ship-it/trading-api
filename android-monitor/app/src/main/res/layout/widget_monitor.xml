<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="13dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="BYBIT // MONITOR" android:fontFamily="monospace" android:textStyle="bold" android:textColor="#00E5FF" android:textSize="11sp" />
        <TextView android:id="@+id/widget_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OFFLINE" android:fontFamily="monospace" android:textStyle="bold" android:textColor="#78909C" android:textSize="10sp" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="EQUITY" android:fontFamily="monospace" android:textColor="#78909C" android:textSize="9sp" />
    <TextView android:id="@+id/widget_equity" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="$--" android:fontFamily="monospace" android:textColor="#F5F7FA" android:textStyle="bold" android:textSize="27sp" />
    <TextView android:id="@+id/widget_pnl" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PnL --" android:fontFamily="monospace" android:textColor="#70FFB1" android:textSize="12sp" />
    <TextView android:id="@+id/widget_ws" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="WS --" android:fontFamily="monospace" android:textColor="#78909C" android:textSize="10sp" />
</LinearLayout>
